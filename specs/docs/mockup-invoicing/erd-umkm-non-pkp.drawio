<mxCell id="e2" value="1 TOP = 1 invoice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToOne;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="top" target="inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
