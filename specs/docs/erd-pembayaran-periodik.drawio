e="1" parent="1" source="prd" target="vrp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r13" value="ids / id_payment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.84;entryDx=0;entryDy=0;" edge="1" parent="1" source="prd" target="rp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="856"/><mxPoint x="810" y="732"/></Array></mxGeometry></mxCell><mxCell id="r14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="vrp" target="rpd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r15" value="id_pengajuan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rph" target="rpd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r16" value="payment_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pa" target="pad"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r17" value="no_item = no_doc  (Paid)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prd" target="pad"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="624" y="1210"/><mxPoint x="1390" y="1210"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key, &lt;b&gt;UK&lt;/b&gt; unique, &lt;b&gt;FK&lt;/b&gt; foreign key (relasi logis, tidak semua dipasang constraint di DB).&lt;br&gt;Putih: tabel yang ada di kode. Abu-abu: tabel master di luar modul. Biru: tabel Request Payment lama. Ungu: view.&lt;br&gt;&lt;font color='#B46504'&gt;&lt;b&gt;Oranye putus-putus / kolom bertanda *&lt;/b&gt;: usulan dari mockup (input/Periodik.html), belum ada di kode: Approval Perubahan Budget (BG-YYMM-NNN, diputuskan Direktur per baris), kolom aktif/masa di budget, resub_as (item ditolak diajukan ulang sebagai PI baru) dan closed_ket/closed_at (Tidak diajukan ulang, alasan wajib).&lt;/font&gt;&lt;br&gt;&lt;b&gt;item_status&lt;/b&gt;: 0 menunggu approval, 1 approved, 2 diproses finance, 8 ditolak Direktur, 9 ditolak di Request Payment.&lt;br&gt;&lt;b&gt;Data lama&lt;/b&gt;: no_item NULL, v_request_payment tetap memakai no_doc batch. Status Paid dicek dari payment_approve.no_doc.&lt;br&gt;Nomor item di kode masih dari format_nonpo (PERIODIK-YYYY-NNNNN), target PI-YYYY-NNNNN." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="360" height="240" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>