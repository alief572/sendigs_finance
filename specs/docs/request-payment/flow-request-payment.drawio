<mxfile host="Electron"><diagram id="rp" name="Request Payment ke Payment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rp-x1" value="&lt;b&gt;Request Payment → Approval → Record → Payment (to-be)&lt;/b&gt;&lt;br&gt;Sumber dokumen (sudah disetujui di modul asal): Kasbon, Expense, Transport, Periodik, Direct Payment, Petty Cash. 1 PGJ = 1 company = 1 batch approval; 1 transfer = 1 rekening tujuan = 1 Payment. Detail jurnal menyusul." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="rp-pool2" value="Sentral (STM / VUCA / SUSTAIN)" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=1;startSize=20;horizontalStack=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1860" height="560" as="geometry"/></mxCell><mxCell id="rp-lane3" value="Admin Finance" style="swimlane;html=1;startSize=20;horizontal=0;" vertex="1" parent="rp-pool2"><mxGeometry y="20" width="1860" height="200" as="geometry"/></mxCell><mxCell id="rp-lane4" value="Direktur (Approver)" style="swimlane;html=1;startSize=20;horizontal=0;" vertex="1" parent="rp-pool2"><mxGeometry y="220" width="1860" height="160" as="geometry"/></mxCell><mxCell id="rp-lane5" value="Finance (Payment)" style="swimlane;html=1;startSize=20;horizontal=0;" vertex="1" parent="rp-pool2"><mxGeometry y="380" width="1860" height="180" as="geometry"/></mxCell><mxCell id="rp-e6" value="Dokumen siap bayar" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;fontSize=11;outline=standard;symbol=general;labelWidth=150;" vertex="1" parent="rp-lane3"><mxGeometry x="60" y="80" width="40" height="40" as="geometry"/></mxCell><mxCell id="rp-g7" value="" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;whiteSpace=wrap;fontSize=11;labelWidth=130;gwType=exclusive;outline=none;symbol=none;" vertex="1" parent="rp-lane3"><mxGeometry x="140" y="80" width="40" height="40" as="geometry"/></mxCell><mxCell id="rp-t8" value="Pilih dokumen siap bayar di Request Payment (1 company)" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=11;spacingTop=14;spacingLeft=4;spacingRight=4;taskMarker=user;" vertex="1" parent="rp-lane3"><mxGeometry x="220" y="60" width="120" height="80" as="geometry"/></mxCell><mxCell id="rp-t9" value="Atur Pembayaran: gabung transfer, rekening tujuan, admin, lampiran tambahan (opsional)" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=11;spacingTop=14;spacingLeft=4;spacingRight=4;taskMarker=user;" vertex="1" parent="rp-lane3"><mxGeometry x="380" y="60" width="140" height="80" as="geometry"/></mxCell><mxCell id="rp-t10" value="Ajukan untuk approval (PGJ)" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgrap