y="150" width="146" height="66" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2. Konfirmasi Diterima&lt;/b&gt;&lt;br&gt;no resi, tanggal diterima" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1484" y="445" width="146" height="66" as="geometry"/></mxCell><mxCell id="y2" value="Umur piutang mulai dihitung dari tanggal diterima; jadwal FU1 = terima + 3 hari" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1659" y="730" width="146" height="66" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;3. Follow Up Customer&lt;/b&gt;&lt;br&gt;PIC, FU n: tanggal dilakukan + keterangan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1834" y="445" width="146" height="66" as="geometry"/></mxCell><mxCell id="c2" value="Menjawab follow up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2009" y="150" width="146" height="66" as="geometry"/></mxCell><mxCell id="g2" value="Ada rencana tanggal bayar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2207" y="440" width="100" height="76" as="geometry"/></mxCell><mxCell id="y3" value="Usulan jadwal FU berikutnya: +7 / +14 / +14, FU 5 dst. +14 (bisa diedit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2009" y="697" width="146" height="66" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;4. Tunggu Bayar &amp;amp; Close&lt;/b&gt;&lt;br&gt;isi plan bayar; FU berhenti, data terkunci" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2359" y="445" width="146" height="66" as="geometry"/></mxCell><mxCell id="c3" value="Transfer pembayaran" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2534" y="150" width="146" height="66" as="geometry"/></mxCell><mxCell id="r1" value="Alokasi uang masuk bank ke invoice (kas, admin, PPh aktual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2709" y="590" width="146" height="66" as="geometry"/></mxCell><mxCell id="y4" value="Kurangi saldo_piutang, jurnal penerimaan draf, catat realisasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2884" y="730" width="146" height="66" as="geometry"/></mxCell><mxCell id="g3" value="Pembayaran selesai?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3082" y="440" width="100" height="76" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Close invoice&lt;/b&gt;&lt;br&gt;hanya bila lunas; keterangan wajib" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3234" y="445" width="146" height="66" as="geometry"/></mxCell><mxCell id="e0" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#B20000;fontColor=#ffffff;fontSize=10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="3460" y="456" width="44" height="44" as="geometry"/></mxCell><mxCell id="e0_lbl" value="Invoice close, masuk Laporan Invoice Close" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3417" y="502" width="130" height="30" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;Monitoring Piutang&lt;/b&gt;: card Lancar ≤60, Potensi Macet 61–90, Macet &amp;gt;90 hari" style="round