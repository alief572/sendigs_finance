<mxfile host="drawio"><diagram id="flow-invoice-piutang" name="Flow Invoice - Monitoring Piutang"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Alur Proses: Invoice sampai Monitoring Piutang&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Plan Tagih → Invoicing (tab Konsultasi / Invoiced) → Follow Up Piutang (tab 1–4) → Penerimaan Uang → Close; dipantau di Monitoring Piutang dan Dashboard Plan Bayar. Garis putus-putus = data yang dibaca menu monitoring. Per 2026-11-05; rincian aturan di fr-nfr-monitoring-piutang.md.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1800" height="50" as="geometry"/></mxCell><mxCell id="ph1" value="INVOICING" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#333333;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="74" y="74" width="1042" height="28" as="geometry"/></mxCell><mxCell id="ph2" value="FOLLOW UP PIUTANG" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#333333;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1124" y="74" width="1392" height="28" as="geometry"/></mxCell><mxCell id="ph3" value="PENERIMAAN &amp;amp; CLOSE" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#333333;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2524" y="74" width="1042" height="28" as="geometry"/></mxCell><mxCell id="ln_cust" value="Customer" style="swimlane;horizontal=0;startSize=34;html=1;whiteSpace=wrap;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f533;fontSize=12;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="11