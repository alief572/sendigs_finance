target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5" target="e0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f19n" value="Tidak, masih ada sisa (cicilan)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3132" y="124"/><mxPoint x="2607" y="124"/></Array></mxGeometry></mxCell><mxCell id="d1" value="data umur" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="y2" target="m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1732" y="900"/></Array></mxGeometry></mxCell><mxCell id="m_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m_2" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m_3" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="e1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2082" y="938"/><mxPoint x="2082" y="968"/></Array></mxGeometry></mxCell><mxCell id="d2" value="realisasi + plan bayar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="y4" target="m3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2957" y="900"/></Array></mxGeometry></mxCell><mxCell id="n1" value="Aturan invoice (v3): Penjualan = nominal TOP; DPP = ×11/12; PPN = DPP ×12%; total = penjualan + PPN. Piutang awal: PKP = total, WAPU/KB = penjualan. PPh tidak dipotong saat invoice, dicatat aktual saat penerimaan. Satu TOP = satu invoice." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="84" y="1080" width="680" height="86" as="geometry"/></mxCell><mxCell id="n2" value="Aturan follow up: harus berurutan kirim → diterima → FU. Keterangan wajib sebelum FU ditandai dilakukan; PIC wajib sebelum FU pertama. Step tersimpan terkunci saat step berikutnya disimpan (kirim → saat terima disimpan; terima → saat FU 1; FU n → saat FU n+1). Plan bayar menghentikan FU dan mengunci data AR. Close hanya bila plan bayar ada dan sudah lunas." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="784" y="1080" width="680" height="86" as="geometry"/></mxCell><mxCell id="n3" value="Aturan monitoring: piutang = saldo_piutang &amp;gt; 0, belum close, sudah diterima customer. Umur = hari ini − tanggal diterima. Dashboard: plan = sisa piutang saat plan dibuat, per bulan plan bayar (termasuk invoice yang sudah close); realisasi = penerimaan per bulan tanggal transaksi bank." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1484" y="1080" width="680" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>