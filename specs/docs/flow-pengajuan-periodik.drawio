<mxfile host="app.diagrams.net"><diagram id="flow-periodik" name="Flow Pembayaran Periodik"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ln_admin" value="Admin Departemen (Pengaju)" style="swimlane;horizontal=0;startSize=34;html=1;fillColor=#dae8fc;swimlaneFillColor=#dae8fc33;fontSize=12;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="3600" height="200" as="geometry"/></mxCell><mxCell id="ln_sys" value="Sistem" style="swimlane;horizontal=0;startSize=34;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f533;fontSize=12;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="3600" height="200" as="geometry"/></mxCell><mxCell id="ln_appr" value="Approver (Direktur)" style="swimlane;horizontal=0;startSize=34;html=1;fillColor=#d5e8d4;swimlaneFillColor=#d5e8d433;fontSize=12;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="0" y="440" width="3600" height="200" as="geometry"/></mxCell><mxCell id="ln_fin" value="Finance – Request Payment (lanjutan)" style="swimlane;horizontal=0;startSize=34;html=1;fillColor=#e1d5e7;swimlaneFillColor=#e1d5e733;fontSize=12;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="0" y="640" width="3600" height="200" as="geometry"/></mxCell><mxCell id="ph1" value="1. Budget Pembayaran Periodik  →  Approval Perubahan Budget" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#333333;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="2" width="1520" height="30" as="geometry"/></mxCell><mxCell id="ph2" value="2. Pengajuan Pembayaran Periodik  →  Approval Pengajuan Periodik" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#333333;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1580" y="2" width="2010" height="30" as="geometry"/></mxCell><mxCell id="a_start" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;fillColor=#60a917;strokeColor=#2D7600;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="40" height="40" as="geometry"/></mxCell><mxCell id="a_open" value="Buka menu &lt;b&gt;Budget Pembayaran Periodik&lt;/b&gt;, pilih Departemen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="105" width="170" height="70" as="geometry"/></mxCell><mxCell id="s_lock" value="Ada perubahan BG&lt;br&gt;dept ini yang masih&lt;br&gt;menunggu approval?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="290" width="150" height="100" as="geometry"/></mxCell><mxCell id="s_lockmsg" value="Tabel budget terkunci + link ke Approval Perubahan Budget (tunggu keputusan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="505" width="170" height="70" as="geometry"/></mxCell><mxCell id="a_edit" value="Ubah master budget:&lt;br&gt;• tambah item baru&lt;br&gt;• ubah nominal / masa berlaku&lt;br&gt;&amp;nbsp;&amp;nbsp;(Selalu / Terbatas n×)&lt;br&gt;• aktif / nonaktif&lt;br&gt;→ &lt;b&gt;Ajukan perubahan&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="180" height="100" as="geometry"/></mxCell><mxCell id="s_valid" value="Valid?&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;nama terisi, biaya &amp;gt; 0,&lt;br&gt;masa ≥ terpakai,&lt;br&gt;ada perubahan&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="285" width="170" height="110" as="geometry"/></mxCell><mxCell id="s_bg" value="Simpan sebagai &lt;b&gt;No. Perubahan BG-YYMM-NNN&lt;/b&gt; (pending).&lt;br&gt;Master belum berubah" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="300" width="170" height="80" as="geometry"/></mxCell><mxCell id="p_list" value="&lt;b&gt;Approval Perubahan Budget&lt;/b&gt; → tab Menunggu approval → Proses approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="505" width="170" height="70" as="geometry"/></mxCell><mxCell id="p_dec" value="Keputusan &lt;b&gt;per baris perubahan&lt;/b&gt;: Approve / Reject (alasan reject wajib) → Simpan keputusan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="495" width="180" height="90" as="geometry"/></mxCell><mxCell id="s_apply" value="Per baris:&lt;br&gt;Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="290" width="150" height="100" as="geometry"/></mxCell><mxCell id="s_yes" value="Terapkan ke master budget (item baru dibuat / field diperbarui)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="255" width="170" height="60" as="geometry"/></mxCell><mxCell id="s_no" value="Master tetap; alasan reject tercatat di Record approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="360" width="170" height="60" as="geometry"/></mxCell><mxCell id="a_result" value="BG selesai, tabel dept terbuka lagi. Budget aktif ter-update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="105" width="170" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_start" target="a_open"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_open" target="s_lock"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_lock" target="s_lockmsg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_lock" target="a_edit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="menunggu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="s_lockmsg" target="p_list"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_edit" target="s_valid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Tidak – pesan error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_valid" target="a_edit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_valid" target="s_bg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_bg" target="p_list"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_list" target="p_dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_dec" target="s_apply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_apply" target="s_yes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_apply" target="s_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_yes" target="a_result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_no" target="a_result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b_new" value="&lt;b&gt;Pengajuan Pembayaran Periodik&lt;/b&gt; → + New (Departemen &amp;amp; tanggal/periode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="105" width="170" height="70" as="geometry"/></mxCell><mxCell id="s_form" value="Tampilkan item budget dept:&lt;br&gt;• nonaktif → tidak muncul&lt;br&gt;• masa Terbatas habis → tidak bisa dipilih&lt;br&gt;• sudah diajukan periode ini → terkunci" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1590" y="275" width="190" height="130" as="geometry"/></mxCell><mxCell id="b_fill" value="Isi nilai per item, keterangan, lampiran → &lt;b&gt;Simpan&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1830" y="105" width="170" height="70" as="geometry"/></mxCell><mxCell id="s_chk" value="Item sudah diajukan&lt;br&gt;di periode ini (bulan/&lt;br&gt;tahun) &amp;amp; belum ditolak?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2000" y="285" width="170" height="110" as="geometry"/></mxCell><mxCell id="s_save" value="Buat batch &lt;b&gt;BP-YYMM-NNN&lt;/b&gt; (status 0).&lt;br&gt;Tiap item dapat &lt;b&gt;PI-YYYY-NNNNN&lt;/b&gt;, item_status 0 (Waiting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="2215" y="290" width="190" height="100" as="geometry"/></mxCell><mxCell id="a_editbatch" value="(Opsional) Edit / hapus batch selama belum diputuskan approver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2220" y="105" width="180" height="70" as="geometry"/></mxCell><mxCell id="q_list" value="&lt;b&gt;Approval Pengajuan Periodik&lt;/b&gt; → Proses approval batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2220" y="505" width="180" height="70" as="geometry"/></mxCell><mxCell id="q_dec" value="Keputusan &lt;b&gt;per item&lt;/b&gt;: Approve / Reject (alasan reject wajib) → Simpan keputusan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2445" y="495" width="180" height="90" as="geometry"/></mxCell><mxCell id="s_upd" value="Approve → item_status 1&lt;br&gt;Reject → item_status 8&lt;br&gt;Header status 1; sts_reject = 1 bila semua item ditolak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="2440" y="290" width="190" height="100" as="geometry"/></mxCell><mxCell id="s_stat" value="Status item?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2680" y="290" width="150" height="100" as="geometry"/></mxCell><mxCell id="a_resub" value="Item ditolak, pilih salah satu:&lt;br&gt;• &lt;b&gt;ajukan ulang di batch baru&lt;/b&gt; (tercatat &quot;Revisi dari PI-…&quot;)&lt;br&gt;• &lt;b&gt;Tidak diajukan ulang&lt;/b&gt; + alasan wajib → item ditutup untuk periode itu (stepper: Ditutup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2655" y="75" width="200" height="130" as="geometry"/></mxCell><mxCell id="s_note" value="&lt;b&gt;Status batch&lt;/b&gt; (rekap item):&lt;br&gt;• Waiting Approval&lt;br&gt;• Partially Approved&lt;br&gt;• Approved (semua item)&lt;br&gt;• Rejected (semua item ditolak)&lt;br&gt;Tab &lt;i&gt;Per Batch&lt;/i&gt; &amp;amp; &lt;i&gt;Per Item&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="2870" y="280" width="230" height="120" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_result" target="b_new"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_new" target="s_form"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" va